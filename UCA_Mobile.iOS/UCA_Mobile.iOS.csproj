<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UCA_Mobile\UCA_Mobile.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <EnableCodeSigning>false</EnableCodeSigning>
    <_SkipXcodeVersionCheck>true</_SkipXcodeVersionCheck>
    <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
    <_RequireCodeSigning>false</_RequireCodeSigning>
  </PropertyGroup>
  
  <Target Name="_DetectSigningIdentity" />
</Project>




